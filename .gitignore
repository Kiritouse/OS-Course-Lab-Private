# Lab6 keeps a private chcore-libc/musl-libc copy; cmake's do_override_dir.sh
# symlinks these in at configure time using this machine's absolute path,
# so they are build output and must not be committed as source.
Lab6/user/chcore-libc/musl-libc/Makefile
Lab6/user/chcore-libc/musl-libc/configure
Lab6/user/chcore-libc/musl-libc/arch/aarch64/syscall_arch.h
Lab6/user/chcore-libc/musl-libc/arch/generic/bits/errno.h
Lab6/user/chcore-libc/musl-libc/arch/remove_bak.sh
Lab6/user/chcore-libc/musl-libc/include/chcore
Lab6/user/chcore-libc/musl-libc/include/chcore-internal
Lab6/user/chcore-libc/musl-libc/src/chcore-port
Lab6/user/chcore-libc/musl-libc/src/thread/aarch64/CMakeLists.txt
Lab6/user/chcore-libc/musl-libc/lib/
Lab6/user/chcore-libc/musl-libc/obj/
Lab6/user/chcore-libc/musl-libc/**/*.obj

# Thirdparty/musl-libc build outputs (regenerated by ./configure && make)
Thirdparty/musl-libc/config.mak
Thirdparty/musl-libc/lib/
Thirdparty/musl-libc/obj/

