{
	"name": "OS-Course-Lab-Dev",
	"build": { "dockerfile": "Dockerfile" },
	"remoteUser": "stu",
	"updateRemoteUserUID": true,
	"runArgs": ["--hostname", "Chcore","--cap-add=SYS_PTRACE",
    "--security-opt",
    "seccomp=unconfined"],
	"customizations": {
		"vscode": {
		"extensions": [
			"ms-vscode.cpptools",
			"ms-vscode.hexeditor",
			"llvm-vs-code-extensions.vscode-clangd",
			"ms-vscode.makefile-tools",
			"twxs.cmake",
			"dan-c-underwood.arm"
		],
		"settings": {
			"terminal.integrated.defaultProfile.linux": "bash"
		}
	}
  }
}
